<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Lift transitive SQLitePCLRaw to 3.x: every 2.1.x has GHSA-2m69-gcr7-jv3q with no 2.x patch -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\database\migrations\*.sql"
                      Link="Migrations\%(Filename)%(Extension)"
                      LogicalName="Migrations.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
